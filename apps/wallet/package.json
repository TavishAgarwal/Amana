  },
  "dependencies": {
    "@amana/ui": "workspace:*",
    "jsqr": "^1.4.0",
    "next": "^16.4.5",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@huggingface/transformers": "3",
    "@openmined/psi.js": "^2.0.6",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "axe-core": "^4.14.0",
    "typescript": "^7.0.2"
  }
}

{
  "name": "@amana/wallet",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3010",
    "build": "next build",
    "lint": "tsc --noEmit",
    "test": "node --no-warnings --experimental-strip-types --test tests/*.test.mjs && node tests/qr-roundtrip.mjs",
